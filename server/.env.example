# Copy to .env (git-ignored). Every value has a working local default.
FINPULSE_DATABASE_URL=postgresql+psycopg://finpulse:finpulse@127.0.0.1:5433/finpulse

# Where raw and derived files live (git-ignored)
FINPULSE_DATA_DIR=../data
# The layer 2 collector output that `finpulse ingest corpus` reads
FINPULSE_CORPUS_DIR=../data-set/layer2
# Layer 1 benchmark datasets, used to seed the gazetteer and train the baselines
FINPULSE_BENCHMARK_DIR=../data-set/layer1

# Local models, served by Ollama (never a hosted API)
FINPULSE_OLLAMA_URL=http://127.0.0.1:11435
FINPULSE_EVENT_MODEL=qwen2.5:7b-instruct
FINPULSE_SUMMARY_MODEL=llama3.1:8b-instruct-q4_K_M

# Browser origins allowed to call the API
FINPULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
